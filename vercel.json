{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "iaturismo.vercel.app"
        },
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "https://painel.tripsol.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "iaturismo-two.vercel.app"
        },
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "https://painel.tripsol.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/app/:path*",
      "destination": "https://sol-api.2-24-73-122.sslip.io/api/app/:path*"
    },
    {
      "source": "/sol/privacidade",
      "destination": "/sol/privacidade.html"
    },
    {
      "source": "/sol/termos",
      "destination": "/sol/termos.html"
    },
    {
      "source": "/sol/suporte",
      "destination": "/sol/suporte.html"
    },
    {
      "source": "/sol/excluir-conta",
      "destination": "/sol/excluir-conta.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
